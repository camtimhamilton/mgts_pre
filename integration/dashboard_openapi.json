          },
          "mapping": {
            "type": "string",
            "title": "Mapping"
          },
          "sheet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sheet"
          },
          "default_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Role"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "import"
          }
        },
        "type": "object",
        "required": [
          "file",
          "mapping"
        ],
        "title": "Body_commit_api_import_commit_post"
      },
      "Body_preview_api_import_preview_post": {
        "properties": {
          "file": {
            "type": "string",
