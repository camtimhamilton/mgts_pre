# Settings are read from environment; .env is not automatically loaded.
MGTS_PROVIDER=mock
PULSE_TEXT_MODE=local_rules
DEEPSEEK_SUMMARY_BUILDER_MODEL=deepseek-flash
MGTS_DATABASE=data/demo.sqlite3
# Only synthetic processing is permitted. .env is NOT automatically loaded.
# To call DeepSeek set MGTS_PROVIDER=deepseek and opt in explicitly:
MGTS_ALLOW_SYNTHETIC_LLM=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SIGNAL_EXTRACTOR_MODEL=deepseek-flash
DEEPSEEK_SIGNAL_EXTRACTOR_THINKING=0
DEEPSEEK_SIGNAL_EXTRACTOR_MAX_TOKENS=4096
DEEPSEEK_RULE_EXTRACTOR_MODEL=deepseek-v4-pro
DEEPSEEK_RULE_EXTRACTOR_THINKING=0
DEEPSEEK_RULE_EXTRACTOR_MAX_TOKENS=4096
DEEPSEEK_SEMANTIC_VALIDATOR_MODEL=deepseek-v4-pro
DEEPSEEK_SEMANTIC_VALIDATOR_THINKING=0
DEEPSEEK_SEMANTIC_VALIDATOR_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_TOTAL_TIMEOUT_SECONDS=90
DEEPSEEK_QUEUE_TIMEOUT_SECONDS=2
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_CONCURRENCY=2
DEEPSEEK_RETRY_BASE_SECONDS=0.5
DEEPSEEK_RETRY_MAX_SECONDS=5
# Separate opt-in for paid test; never required by normal tests:
MGTS_RUN_DEEPSEEK_SMOKE=0
